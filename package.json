{
  "name": "hourra",
  "productName": "Hourra",
  "version": "2.0.2",
  "description": "Hourra – planning de révisions basé sur la méthode des J, hors-ligne et 100 % personnalisable",
  "main": "src/main.js",
  "author": "Theo Fabiano Mattei",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "dist": "npm run icon && electron-builder --win --publish never",
    "pack": "electron-builder --win --dir"
  },
  "build": {
    "appId": "app.hourra.revisions",
    "productName": "Hourra",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hourra",
      "artifactName": "Hourra-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Hourra-portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TheoEwzZer",
        "repo": "hourra"
      }
    ]
  },
  "devDependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/comic-neue": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "material-symbols": "^0.48.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://github.com/TheoEwzZer/hourra",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheoEwzZer/hourra.git"
  },
  "bugs": {
    "url": "https://github.com/TheoEwzZer/hourra/issues"
  }
}
